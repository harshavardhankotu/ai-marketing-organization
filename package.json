{
  "name": "ai-marketing-organization-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "start": "node packages/backend/dist/index.js",
    "serve": "npm run build && npm start",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=packages/backend && npm run build --workspace=packages/frontend && npm run build --workspace=packages/cloudflare-worker",
    "prepare-deploy": "node scripts/prepare-deploy.mjs",
    "typecheck": "npm run typecheck --workspace=packages/shared && npm run typecheck --workspace=packages/backend && npm run typecheck --workspace=packages/frontend && npm run typecheck --workspace=packages/cloudflare-worker",
    "dev:backend": "npm run dev --workspace=packages/backend",
    "dev:frontend": "npm run dev --workspace=packages/frontend",
    "test": "npm run test --workspace=packages/backend",
    "seed": "npm run seed --workspace=packages/backend",
    "board:sync": "node scripts/board-sync.mjs",
    "board:preflight": "node scripts/board-preflight.mjs",
    "board:verify": "node scripts/board-verify.mjs",
    "lint:rupee-estimates": "node scripts/lint-no-unbacked-rupee-estimates.mjs",
    "check:no-scratch-writes": "node scripts/check-no-scratch-writes.mjs",
    "status:generate": "node scripts/generate-status.mjs",
    "system-map:generate": "node scripts/generate-system-map.mjs",
    "floki:orchestrate": "python scripts/floki_marketing_runner.py"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}