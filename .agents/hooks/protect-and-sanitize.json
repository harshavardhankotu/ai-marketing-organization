{
  "protect-and-sanitize": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "replace_file_content|write_to_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/scripts/protect-and-sanitize.cjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
