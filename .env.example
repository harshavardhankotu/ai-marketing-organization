# =====================================================================
# AI MARKETING ORGANIZATION - ENVIRONMENT CONFIGURATION
# Copy this file to '.env' in this directory or in packages/backend/.env.
# NOTE: '.env' and '.env.local' are listed in .gitignore and will NEVER be committed.
# =====================================================================

# 1. Google Gemini API Key (Required for AI Agents & Search Grounding)
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. Google Custom Search JSON API (Optional - Dual Search Engine 1)
# Step A: In GCP Console, enable "Custom Search API" and generate an API key
GOOGLE_SEARCH_API_KEY=

# Step B: At https://programmablesearchengine.google.com/
# Create a search engine with "Search the entire web" enabled, then copy the Search Engine ID:
GOOGLE_SEARCH_CX=

# 3. Server Configuration (Optional defaults)
PORT=3000
NODE_ENV=development

# 4. Money / Commercial providers (Required for real revenue - never commit real values)
# Razorpay (INR checkout, payment links, webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Stripe (non-INR checkout + webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Outbound (prospect -> proposal -> payment link)
SENDGRID_API_KEY=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Owner / platform settlement
PLATFORM_UPI_VPA=
OWNER_API_KEY=
CRON_PING_SECRET=

# 5. Affiliate networks (Phase 1 commission engine — REQUIRED for real revenue)
# Amazon Associates: SiteStripe tag, e.g. yoursite-21 (https://affiliate-program.amazon.in)
AMAZON_AFFILIATE_TAG=
# eBay Partner Network: your campid (https://epn.ebay.com)
EBAY_CAMPID=
EBAY_TOOLID=10001
