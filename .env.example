# ==============================================================================
# AI Marketing Organization - Environment Configuration
# ==============================================================================

# Node Environment & Server Port
NODE_ENV=development
PORT=3001

# Google Gemini API Key
# If not provided or set to 'demo_key', the system operates using its built-in
# high-fidelity domain synthesis engine for zero-dependency local execution.
GEMINI_API_KEY=demo_key

# Payment Gateways (Optional for live webhook ingestion & direct checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Clinic / Tenant Configuration
DEFAULT_ORGANIZATION_ID=org_smilekraft_01
DEFAULT_BUSINESS_ID=biz_smilekraft_hyd
