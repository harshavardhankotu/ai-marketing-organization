# =====================================================================
# AI MARKETING ORGANIZATION - ENVIRONMENT CONFIGURATION
# Copy this file to '.env' in this directory or in packages/backend/.env.
# NOTE: '.env' and '.env.local' are listed in .gitignore and will NEVER be committed.
# =====================================================================

# 1. Google Gemini API Key (Required for AI Agents & Search Grounding)
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# 2. Google Custom Search JSON API (Optional - Dual Search Engine 1)
# Step A: In GCP Console, enable "Custom Search API" and generate an API key
GOOGLE_SEARCH_API_KEY=

# Step B: At https://programmablesearchengine.google.com/
# Create a search engine with "Search the entire web" enabled, then copy the Search Engine ID:
GOOGLE_SEARCH_CX=

# 3. Server Configuration (Optional defaults)
PORT=3000
NODE_ENV=development
